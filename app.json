{
  "expo": {
    "name": "WaKira",
    "slug": "wakira",
    "version": "3.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wakira",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/e4b91d23-a92b-488f-8aec-167121986d6a",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.haziqaql.wakira",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.haziqaql.wakira",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "name": "WaKira",
      "shortName": "WaKira",
      "themeColor": "#208AEF",
      "backgroundColor": "#FFFFFF",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#208AEF"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "WaKira uses motion so your premium cards can tilt as you move your phone."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "WaKira uses Face ID to unlock the app."
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "WaKira uses the camera so you can scan a receipt.",
          "photosPermission": "WaKira reads the receipt photo you choose.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "expo-apple-authentication",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4b91d23-a92b-488f-8aec-167121986d6a"
      }
    }
  }
}
