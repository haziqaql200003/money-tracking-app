# Salin fail ini ke .env.local (jangan commit) dan isi dari Supabase:
# Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Guna kunci "anon" / "publishable" SAHAJA. JANGAN PERNAH letak "service_role" di sini.
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# E-mel anda untuk butang "Hantar melalui e-mel" dalam Maklum balas (pilihan; kosongkan untuk sembunyikan butang).
EXPO_PUBLIC_FEEDBACK_EMAIL=
